{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://extensions.monetenapp.com/schema/index.schema.json",
  "title": "Moneten catalog index",
  "description": "index.json at https://extensions.monetenapp.com/. index.json.sig holds the raw 64-byte Ed25519 signature of the exact bytes of index.json. A package file is served at /<id>/<manifest.version>/<path>.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "version", "published", "extensions"],
  "properties": {
    "formatVersion": {"const": 1},
    "version": {
      "description": "One higher than the version of the index published before it. The app rejects an index whose version is lower than the newest one it accepted.",
      "type": "integer",
      "minimum": 1
    },
    "published": {
      "description": "The UTC time of the signing run.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "extensions": {
      "description": "Every package, sorted by id.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "manifest", "files"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "status": {"enum": ["active", "blocked", "withdrawn", "unmaintained"]},
          "note": {"description": "Present when status is not active.", "type": "string", "minLength": 1},
          "manifest": {"$ref": "manifest.schema.json"},
          "files": {
            "description": "Every file the app installs, sorted by path. The recording is not part of it.",
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "size", "sha256"],
              "properties": {
                "path": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
                "size": {"type": "integer", "minimum": 0},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
